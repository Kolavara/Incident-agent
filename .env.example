# =============================================================================
# Incident Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED variables are marked below. Everything else has sensible defaults.

# -----------------------------------------------------------------------------
# LLM PROVIDER - GROQ (REQUIRED)
# -----------------------------------------------------------------------------
# Get a free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# -----------------------------------------------------------------------------
# MODEL ROUTING - cascadeflow
# -----------------------------------------------------------------------------
# Budget cap in USD - agent falls back to free local Ollama once this limit
# is reached.
BUDGET_CAP_USD=1.00

# Cheap model - used for known / similar incidents (fast, low cost)
CHEAP_MODEL=groq/llama-3.1-8b-instant

# Powerful model - used for novel / complex incidents (higher quality)
POWERFUL_MODEL=groq/qwen/qwen3-32b

# Local fallback - used when budget is exhausted or no API keys are set
LOCAL_MODEL=ollama/llama3

# -----------------------------------------------------------------------------
# MEMORY - Hindsight
# -----------------------------------------------------------------------------
# Sign up for free: https://ui.hindsight.vectorize.io
# Use promo code MEMHACK515 for $50 in free credits.
HINDSIGHT_API_KEY=hs_your_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_PIPELINE_ID=incident-memory-bank

# -----------------------------------------------------------------------------
# LOCAL INFERENCE - Ollama (fallback)
# -----------------------------------------------------------------------------
# Only needed if running a local Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# LOGGING (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
